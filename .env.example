# ──────────────────────────────────────────────────
# Eth-Links Environment Variables
# Copy this file to .env.local and fill in real values
# ──────────────────────────────────────────────────

# Supabase — Required
NEXT_PUBLIC_SUPABASE_URL=changeme
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Application
ADMIN_EMAIL=changeme
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google AI (Gemini)
GOOGLE_API_KEY=changeme
GEMINI_MODEL_VERSION=gemini-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.9
AI_TOP_K=40

# Payment
# PAYMENT_MODE=simulation → no live Chapa (default if no CHAPA_SECRET_KEY)
# PAYMENT_MODE=live       → real Chapa
# SIMULATION_AUTO_CONFIRM=true (default) → user Pay now marks booking paid
#   set to false only if you want admin to click Confirm for every payment
PAYMENT_MODE=simulation
SIMULATION_AUTO_CONFIRM=true
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Optional email receipts (Resend.com) — leave empty to skip email
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Eth-Links <onboarding@resend.dev>

# Upstash Redis — distributed rate limiting (production recommended)
UPSTASH_REDIS_REST_URL=changeme
UPSTASH_REDIS_REST_TOKEN=changeme

# Sentry — error monitoring (optional)
SENTRY_DSN=changeme
SENTRY_ORG=changeme
SENTRY_PROJECT=changeme
