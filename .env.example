# ──────────────────────────────────────────────────
# Eth-Links Environment Variables
# Copy this file to .env.local and fill in real values
# ──────────────────────────────────────────────────

# Supabase — Required
NEXT_PUBLIC_SUPABASE_URL=changeme
NEXT_PUBLIC_SUPABASE_ANON_KEY=changeme
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=changeme
SUPABASE_SERVICE_ROLE_KEY=changeme

# Application
ADMIN_EMAIL=changeme
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Google AI (Gemini)
GOOGLE_API_KEY=changeme
GEMINI_MODEL_VERSION=gemini-pro
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TOP_P=0.9
AI_TOP_K=40

# ── Payments: Chapa escrow + commission + payouts ──────────────────────────
# Leave CHAPA_SECRET_KEY empty → Sandbox mode: checkout opens /checkout/chapa-sandbox,
#   payouts go to a simulated bank (account numbers ending in 0000 fail), but the
#   ledger, escrow and push notifications are all real. Paste real keys → live Chapa,
#   no code changes.
CHAPA_SECRET_KEY=
CHAPA_PUBLIC_KEY=
# Webhook secret from the Chapa dashboard (webhook URL: https://<your-domain>/api/webhooks/chapa)
CHAPA_WEBHOOK_SECRET=
# Transfer approval secret (approval URL: https://<your-domain>/api/webhooks/chapa/transfer-approval)
CHAPA_TRANSFER_APPROVAL_SECRET=
# v1 (api.chapa.co, default) or v2 (api.chapa.global)
CHAPA_API_VERSION=v1
# Sandbox only: let customers press "Simulate payment" themselves (otherwise only admins can)
CHAPA_SANDBOX_SELF_SERVE=false
# Vercel Cron auth for /api/cron/release-escrow (auto-release escrow 48h after the service date)
CRON_SECRET=

# Optional email receipts (Resend.com) — leave empty to skip email
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=Eth-Links <onboarding@resend.dev>

# Upstash Redis — distributed rate limiting (production recommended)
UPSTASH_REDIS_REST_URL=changeme
UPSTASH_REDIS_REST_TOKEN=changeme

# Sentry — error monitoring (optional)
SENTRY_DSN=changeme
SENTRY_ORG=changeme
SENTRY_PROJECT=changeme
